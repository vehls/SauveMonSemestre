# URL publique du site une fois déployé (utilisée pour les balises OpenGraph,
# Twitter Card et les URLs canoniques). Laisser vide en local.
NEXT_PUBLIC_SITE_URL=https://sauvemonsemestre.example.com

# Lien de don affiché dans le bouton "Offrir un café à l'auteur" du footer.
NEXT_PUBLIC_DONATION_URL=https://www.buymeacoffee.com/ton-pseudo

# --- Google AdSense ---
# Tant que ces variables ne sont pas définies, des zones réservées neutres
# sont affichées à la place des publicités (aucun script tiers n'est chargé).
# Identifiant éditeur AdSense (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# ID du bloc publicitaire de la sidebar desktop (300x600)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# ID du bloc publicitaire de la bannière mobile (bas d'écran, format ancre)
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
